# ============================================================
# Smart Contact Saver — Backend Environment Configuration
# ============================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS: allowed frontend origin ---
CLIENT_ORIGIN=http://localhost:3000

# --- Database (MongoDB Atlas connection string) ---
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_contact_saver?retryWrites=true&w=majority
DATABASE_URL=

# --- Phone normalization default country (ISO 3166-1 alpha-2) ---
DEFAULT_COUNTRY=PK

# --- File upload limits ---
MAX_FILE_SIZE=10485760

# ============================================================
# Official Meta WhatsApp Cloud API
# https://developers.facebook.com/docs/whatsapp/cloud-api
# ============================================================

# Permanent or temporary access token from your Meta app
# (WhatsApp > API Setup). Keep this SECRET.
META_WHATSAPP_ACCESS_TOKEN=

# Phone Number ID of your WhatsApp Business number
# (Meta App Dashboard > WhatsApp > API Setup)
META_WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (WABA ID)
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Any random string YOU choose; must match the value entered in
# Meta App Dashboard > WhatsApp > Configuration > Webhook "Verify token"
META_WHATSAPP_VERIFY_TOKEN=

# Meta App ID (App Settings > Basic)
META_APP_ID=

# Meta App Secret (App Settings > Basic) — used to verify the
# X-Hub-Signature-256 signature of incoming webhook requests.
META_APP_SECRET=

# Graph API version (see developers.facebook.com/docs/graph-api/changelog)
META_GRAPH_API_VERSION=v21.0

# Public HTTPS origin Meta will call for webhooks (no trailing slash).
# Localhost is not accepted by Meta — use ngrok, Cloudflare Tunnel, or your deployed host.
# Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# Active WhatsApp provider.
WHATSAPP_PROVIDER=meta_cloud_api